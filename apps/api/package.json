{
    "name": "@mayday-command/api",
    "version": "0.0.0",
    "description": "",
    "author": "",
    "private": true,
    "license": "UNLICENSED",
    "scripts": {
        "build": "nest build && npm run sentry:sourcemaps",
        "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
        "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" --fix",
        "sentry:sourcemaps": "sentry-cli sourcemaps inject --org carbon-digital --project veterandb-api ./dist && sentry-cli sourcemaps upload --org carbon-digital --project veterandb-api ./dist",
        "start:dev": "NODE_ENV=development nest start --watch",
        "start:debug": "NODE_ENV=development nest start --debug --watch",
        "start:prod": "NODE_ENV=production node dist/main.js",
        "test:e2e": "jest --config tests/jest-e2e.json",
        "test:unit": "jest --coverage --config jest.config.ts",
        "typecheck": "tsc --noEmit"
    },
    "devDependencies": {
        "@mayday-command/eslint-config": "file:../../packages/eslint-config",
        "@mayday-command/jest-config": "file:../../packages/jest-config",
        "@mayday-command/prettier-config": "file:../../packages/prettier-config",
        "@mayday-command/typescript-config": "file:../../packages/typescript-config",
        "@nestjs/cli": "^11.0.10",
        "@nestjs/schematics": "^11.0.7",
        "@nestjs/testing": "^12.1.3",
        "@types/cookie-parser": "^1.4.9",
        "@types/express": "^5.0.3",
        "@types/jest": "^30.0.0",
        "@types/lodash": "^4.17.20",
        "@types/multer": "^2.0.0",
        "@types/node": "^24.3.0",
        "@types/nodemailer": "^7.0.1",
        "@types/passport-jwt": "^4.0.1",
        "@types/sharp": "^0.32.0",
        "@types/supertest": "^6.0.3",
        "@typescript-eslint/eslint-plugin": "^8.40.0",
        "@typescript-eslint/parser": "^8.40.0",
        "eslint": "^9.34.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.4",
        "jest": "^30.0.5",
        "prettier": "^3.6.2",
        "source-map-support": "^0.5.21",
        "supertest": "^7.1.4",
        "ts-jest": "^29.4.1",
        "ts-loader": "^9.5.2",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.9.2"
    },
    "dependencies": {
