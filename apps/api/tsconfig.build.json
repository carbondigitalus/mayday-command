{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "noEmit": false,
        "outDir": "./dist",
        "rootDir": "./src",
        "inlineSources": true,
        // Set `sourceRoot` to "/" to strip the build path prefix
        // from generated source code references. This improves issue grouping in Sentry.
        "sourceRoot": "/"
    },
    "exclude": ["tests", "node_modules", "dist"]
}
