{
    "name": "@mayday-command/web",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "next build",
        "build:staging": "NODE_ENV=production dotenv -e .env.staging -- next build",
        "postbuild": "next-sitemap --config sitemap.config.ts",
        "lint": "eslint src --fix",
        "start:dev": "NODE_ENV=development next dev --port 3010",
        "start:prod": "NODE_ENV=production next start",
        "typecheck": "tsc --noEmit"
    },
    "devDependencies": {
        "@types/node": "^24.3.0",
        "@types/react": "19.2.18",
        "@types/react-dom": "19.1.7",
        "@mayday-command/eslint-config": "file:../../packages/eslint-config",
        "@mayday-command/prettier-config": "file:../../packages/prettier-config",
        "@mayday-command/typescript-config": "file:../../packages/typescript-config",
        "dotenv-cli": "^8.0.0",
        "eslint": "^9.34.0",
        "typescript": "5.9.2"
    },
    "dependencies": {
        "@heroui/react": "^2.8.3",
        "@tailwindcss/postcss": "^4.1.13",
        "framer-motion": "^12.23.12",
        "next-seo": "^7.3.0",
        "next-sitemap": "^4.2.3",
        "postcss": "^8.5.6",
        "react": "19.2.9",
        "react-dom": "19.2.9",
        "tailwindcss": "^4.1.13"
    }
}
